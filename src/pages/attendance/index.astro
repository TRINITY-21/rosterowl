---
import Layout from '../../layouts/Layout.astro';
import Faq from '../../components/Faq.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import MoreTools from '../../components/MoreTools.astro';
import AttendanceApp from '../../components/AttendanceApp.svelte';
import { toolJsonLd, type FaqEntry } from '../../lib/seo';

const jsonLd = toolJsonLd({
  name: 'RosterOwl Attendance Roster Maker',
  path: '/attendance/',
  description:
    'Free online attendance roster with your students already listed: pick a month and download a printable one-page sheet — names down the side, every school day (Mon–Fri) across the top. No signup — nothing uploaded unless you turn on sync.',
});

const faqs: FaqEntry[] = [
  {
    q: `Is this an attendance roster or an attendance sheet?`,
    a: `The same thing under different names. Roster, attendance sheet, roll sheet, register, attendance form — whichever your school says, this makes the one-page monthly grid with your class down the side and the month's school days across the top.`,
  },
  {
    q: `What do the blank cells mean?`,
    a: `Whatever you want them to. Mark it your way — ✓ present, A absent, T tardy — it's your system; the sheet just gives you the grid.`,
  },
  {
    q: `What about holidays in the middle of the month?`,
    a: `Cross them out or leave the column blank — the grid lists every Mon–Fri and doesn't assume anything about your district's calendar.`,
  },
  {
    q: `A new student joined — do I redo the sheet?`,
    a: `Add them once to your class list and every future roster includes them, re-alphabetized automatically. That's the point of keeping one roster instead of a folder of spreadsheets.`,
  },
];
---

<Layout
  title="Attendance Roster Maker — Free Monthly Sheet | RosterOwl"
  description="Free online attendance roster in one click: your class list down the side, the month's real school days (Mon–Fri) across the top, blank cells for your own marks. One page, numbered, alphabetized. No signup, no watermark."
>
  <script is:inline type="application/ld+json" set:html={jsonLd} slot="head" />

  <main class="tool-page">
    <div class="page-head">
      <h1>Monthly attendance roster</h1>
      <p>
        Pick a month — your students down the side, every school day (Mon–Fri) across the top,
        blank cells for your own marks. One page, numbered, alphabetized. Free · no signup ·
        <a href="/privacy/">nothing uploaded unless you turn on sync</a>.
      </p>
    </div>

    <AttendanceApp client:only="svelte" />

    <section class="content">
      <h2 class="sr-only">Why teachers use it</h2>
      <div class="feature-grid">
        <div>
          <h3>The month is pre-built</h3>
          <p>
            Pick a month and the grid fills itself with that month's real Mon–Fri dates — the day
            number and weekday over every column. No more counting weekday cells in Excel each
            month.
          </p>
        </div>
        <div>
          <h3>Looks like a real attendance sheet</h3>
          <p>
            Rows are numbered (headcounts in one glance) and sorted the way attendance sheets
            actually work — "Last, First" A→Z — or by first name, or in your roster order.
          </p>
        </div>
        <div>
          <h3>Always one page</h3>
          <p>
            Rows and day columns size themselves to fit the whole class and the whole month on a
            single sheet — even a 22-school-day month.
          </p>
        </div>
        <div>
          <h3>Private by architecture</h3>
          <p>Runs entirely in your browser. No accounts, no uploads, nothing stored anywhere but your device.</p>
        </div>
      </div>

      <h2>Which roster do you need?</h2>
      <p>
        This page fills the grid in from your class list. Three other versions answer the
        situations that come up around it:
      </p>
      <ul class="roster-links">
        <li>
          <a href="/attendance/blank-attendance-roster/">Blank attendance roster</a> — the same
          sheet with empty name rows, for writing in by hand.
        </li>
        <li>
          <a href="/attendance/class-attendance-roster/">One roster per class</a> — a separate
          sheet for each period, all from the same app.
        </li>
        <li>
          <a href="/attendance/for-substitutes/">Attendance roster for a substitute</a> — what to
          leave out so a sub can take the register without you.
        </li>
      </ul>

      <Faq entries={faqs} />
    </section>
    <MoreTools />
  </main>

  <SiteFooter />
</Layout>

<style>
  .content h2 {
    margin-top: var(--space-5);
  }
  .roster-links {
    max-width: 42rem;
  }
  .roster-links li {
    margin-bottom: var(--space-2);
  }
</style>
