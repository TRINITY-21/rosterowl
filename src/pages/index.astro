---
import Icon from '../components/Icon.svelte';
import SiteFooter from '../components/SiteFooter.astro';
import Layout from '../layouts/Layout.astro';
import { PRINTABLES, SEATING, SEATING_VARIANTS, TOOL_GROUPS } from '../lib/tools';

// The flagship leads the index; the other two groups follow as compact rows.
const [, ...otherGroups] = TOOL_GROUPS;

const steps = [
  {
    title: 'Paste your class list',
    copy: 'Straight from your SIS, a spreadsheet, or an email. "Last, First", stray emails and student IDs are cleaned up for you.',
  },
  {
    title: 'Set your rules once',
    copy: 'Keep students apart or together, mark priority seating, and rebuild your real room — gaps, stray pairs and all.',
  },
  {
    title: 'Print all year',
    copy: 'Every tool reads that same roster, so a certificate, a name tag or a register is one click away — no name typed twice.',
  },
];

// The seating chart on the front sheet: four table groups, tinted like the real
// thing. Names only — exactly what the tool actually prints.
const chartGroups = [
  { tint: '--g-blue', names: ['Ava', 'Liam', 'Zoë', 'Noah'] },
  { tint: '--g-coral', names: ['Maya', 'Ethan', 'Sofia', 'Kai'] },
  { tint: '--g-violet', names: ['Mia', 'Leo', 'Ruby', 'Omar'] },
  { tint: '--g-gold', names: ['Grace', 'Mateo', 'Nora', 'Jax'] },
];
---

<Layout
  title="RosterOwl — one roster, every classroom tool"
  description="Paste your class list once. Free seating charts, group makers and classroom printables — unlimited students, no signup, and student names never leave your browser."
>
  <main>
    <section class="hero">
      <div class="hero-copy">
        <h1>One roster.<span>Every classroom tool.</span></h1>
        <p class="sub">
          Paste your class list once. Make seating charts that keep the chatty kids apart,
          shuffle groups, and print clean one-page PDFs — free, with unlimited students, and your
          students' names <strong>never leave your browser</strong>.
        </p>
        <div class="cta-row">
          <a class="btn primary large" href={SEATING.href}>
            Make your seating chart
            <Icon name="arrow-right" size={17} />
          </a>
          <a class="text-link" href="#tools">See all ten tools</a>
        </div>
        <ul class="facts">
          <li>Free</li>
          <li>No signup</li>
          <li>Unlimited students</li>
          <li>Nothing uploaded</li>
        </ul>
      </div>

      <div
        class="sheet-stack"
        role="img"
        aria-label="Three pages RosterOwl prints from one class list: an award certificate, a sheet of desk name plates, and a seating chart for Period 2 in Room 12 with four table groups of four students."
      >
        <div class="sheet cert" aria-hidden="true">
          <div class="cert-frame">
            <span class="cert-kicker">Room 12</span>
            <span class="cert-title">Certificate of Achievement</span>
            <span class="cert-name">Maya Okonkwo</span>
            <span class="cert-rule"></span>
            <span class="cert-note">for outstanding effort in reading</span>
          </div>
        </div>

        <div class="sheet tags" aria-hidden="true">
          <span class="plate">Ethan</span>
          <span class="plate">Sofia</span>
          <span class="plate">Kai</span>
        </div>

        <div class="sheet chart" aria-hidden="true">
          <div class="sh-head">
            <span class="sh-title">Period 2 — Room 12</span>
            <span class="sh-meta">24 students</span>
          </div>
          <div class="sh-room">
            {chartGroups.map((group) => (
              <div class="sh-group" style={`--tint: var(${group.tint})`}>
                {group.names.map((name) => (
                  <span class="sh-desk">{name}</span>
                ))}
              </div>
            ))}
          </div>
          <div class="sh-teacher">Teacher</div>
        </div>

        <span class="stack-chip">
          <Icon name="lock" size={12} />
          Made on your device
        </span>
      </div>
    </section>

    <section class="steps" aria-labelledby="steps-heading">
      <h2 id="steps-heading">Paste once. Print all year.</h2>
      <ol>
        {steps.map((step, i) => (
          <li>
            <span class="num" aria-hidden="true">{i + 1}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.copy}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="suite" id="tools" aria-labelledby="tools-heading">
      <div class="section-head">
        <h2 id="tools-heading">Ten tools. One class list.</h2>
        <p>Move from planning to printing without typing the same names twice.</p>
      </div>

      <h3 class="group-label">Plan the room</h3>
      <a class="flagship" href={SEATING.href}>
        <span class="fl-icon"><Icon name={SEATING.icon} size={22} /></span>
        <span class="fl-body">
          <span class="fl-title">{SEATING.title}</span>
          <span class="fl-copy">{SEATING.copy}</span>
        </span>
        <span class="fl-go" aria-hidden="true"><Icon name="arrow-right" size={18} /></span>
      </a>
      <p class="variants">
        <span>Ready to go:</span>
        {[...SEATING_VARIANTS, PRINTABLES].map((v) => (
          <a href={v.href}>{v.label}</a>
        ))}
      </p>

      {otherGroups.map((group) => (
        <div class="tool-group">
          <h3 class="group-label">{group.label}</h3>
          <ul class="tool-rows">
            {group.tools.map((tool) => (
              <li>
                <a href={tool.href}>
                  <span class="row-icon"><Icon name={tool.icon} size={18} /></span>
                  <span class="row-name">{tool.title}</span>
                  <span class="row-copy">{tool.copy}</span>
                  <span class="row-go" aria-hidden="true"><Icon name="arrow-right" size={16} /></span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <section class="why" aria-labelledby="why-heading">
      <h2 id="why-heading">Built the way school data should be handled</h2>
      <div class="cols">
        <div>
          <h3>Names stay on your device</h3>
          <p>
            RosterOwl does its work inside your browser. Your class list is saved on your own
            computer — no accounts, no servers, nothing for anyone to breach.
          </p>
          <a class="text-link" href="/privacy/">See exactly what this site sends</a>
        </div>
        <div>
          <h3>Genuinely free</h3>
          <p>
            No 25-student cap, no watermark stamped over your chart, no "premium" wall in front of
            the feature you actually need. The core tools stay free — that's the point of the
            project.
          </p>
        </div>
        <div>
          <h3>Readable by design</h3>
          <p>
            Set in Atkinson Hyperlegible, a typeface drawn by the Braille Institute for readers
            with low vision — on screen and on every printed chart.
          </p>
        </div>
      </div>
    </section>

    <section class="closer">
      <div>
        <h2>Start with the seating chart.</h2>
        <p>Paste a class list and you are two minutes from a printable chart. Nothing to sign up for.</p>
      </div>
      <a class="btn primary large" href={SEATING.href}>
        Make your seating chart
        <Icon name="arrow-right" size={17} />
      </a>
    </section>
  </main>

  <SiteFooter note="free classroom tools" />
</Layout>

<style>
  main {
    max-width: var(--content-wide);
    margin: 0 auto;
    padding: 0 var(--page-gutter) var(--space-7);
  }

  /* --- hero ---------------------------------------------------------------- */
  .hero {
    position: relative;
    isolation: isolate;
    padding: clamp(2.25rem, 5vw, 4rem) 0 clamp(2.5rem, 5vw, 4rem);
    display: grid;
    grid-template-columns: minmax(0, 1.16fr) minmax(18rem, 0.8fr);
    align-items: center;
    gap: clamp(2rem, 4vw, 4rem);
  }

  /* Faint ruled paper behind the hero — the school-stationery cue the whole
     page is built on. Fades out before it reaches the next section. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0 calc(-1 * var(--page-gutter));
    z-index: -1;
    pointer-events: none;
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0 1.9rem,
      color-mix(in srgb, var(--brand) 14%, transparent) 1.9rem calc(1.9rem + 1px)
    );
    -webkit-mask-image: linear-gradient(to bottom, #000 10%, transparent 88%);
    mask-image: linear-gradient(to bottom, #000 10%, transparent 88%);
  }

  /* The margin rule of a sheet of notebook paper. Sits in the gutter so the
     copy stays flush with every section below it. */
  .hero-copy {
    position: relative;
  }

  .hero-copy::before {
    content: '';
    position: absolute;
    top: -0.5rem;
    bottom: -0.5rem;
    left: calc(-1 * var(--space-5));
    width: 2px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--accent) 55%, transparent);
  }

  h1 {
    font-size: var(--text-display);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.04;
    color: var(--ink);
  }

  h1 span {
    display: block;
    color: var(--brand);
  }

  .sub {
    max-width: 36rem;
    margin: var(--space-4) 0 var(--space-5);
    font-size: 1.1rem;
    color: var(--muted);
    text-wrap: pretty;
  }

  .sub strong {
    color: var(--ink);
    font-weight: 700;
  }

  .cta-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .text-link {
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 2px solid color-mix(in srgb, var(--brand) 40%, transparent);
    transition: color var(--motion-fast) ease, border-color var(--motion-fast) ease;
  }

  .text-link:hover {
    color: var(--brand);
    border-bottom-color: var(--brand);
  }

  /* Facts, not checkmark pills: one hairline-topped line of plain claims. */
  .facts {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0;
    margin: var(--space-6) 0 0;
    padding: var(--space-4) 0 0;
    border-top: var(--rule);
    color: var(--muted);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .facts li + li {
    margin-left: 0.85rem;
    padding-left: 0.85rem;
    border-left: var(--rule);
  }

  /* --- the printed sheets -------------------------------------------------- */
  /* A size container: every measurement inside a sheet is in em off a base that
     tracks the stack's own width, so the pages scale as one drawing. Fixed-rem
     text on percentage-sized paper overflowed once the stack got narrower —
     the certificate title ran under the sheet in front of it on tablets.
     3.333cqi of the 30rem maximum is exactly 1rem, so desktop is unchanged. */
  .sheet-stack {
    container-type: inline-size;
    position: relative;
    width: 100%;
    max-width: 30rem;
    margin-inline: auto;
    aspect-ratio: 1 / 0.92;
  }

  .sheet {
    position: absolute;
    font-size: 3.333cqi;
    aspect-ratio: 11 / 8.5;
    padding: 5.5%;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: light-dark(#fffdf8, #e8e4d8);
    box-shadow: var(--shadow-paper);
    color: #243230;
    overflow: hidden;
  }

  /* Fanned so each sheet's identifying half stays clear of the one in front:
     the certificate's crest, the top desk plate, and the whole chart. */
  .cert {
    width: 60%;
    top: 0;
    left: 0;
    transform: translateY(0) rotate(-8deg);
  }

  .tags {
    width: 52%;
    top: 1%;
    right: 1%;
    transform: translateY(0) rotate(7deg);
  }

  .chart {
    width: 88%;
    bottom: 0;
    left: 6%;
    transform: translateY(0) rotate(-1.5deg);
    z-index: 2;
  }

  @media (prefers-reduced-motion: no-preference) {
    .sheet {
      animation: sheet-in 620ms var(--ease-standard) backwards;
    }
    .cert {
      animation-delay: 40ms;
    }
    .tags {
      animation-delay: 110ms;
    }
    .chart {
      animation-delay: 180ms;
    }
  }

  @keyframes sheet-in {
    from {
      opacity: 0;
      transform: translateY(16px) rotate(0deg);
    }
  }

  /* certificate */
  /* Content sits high in the sheet: the lower half is behind the chart. */
  .cert-frame {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3%;
    padding: 7% 6% 6%;
    text-align: center;
    border: 2px solid color-mix(in srgb, #e8a03c 70%, transparent);
    outline: 1px solid color-mix(in srgb, #e8a03c 40%, transparent);
    outline-offset: 3px;
  }

  .cert-kicker {
    font-size: 0.42em;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #7a6a4a;
  }

  .cert-title {
    font-family: var(--font-display);
    font-size: 0.82em;
    font-weight: 800;
    line-height: 1.1;
    color: #2e6b4f;
  }

  .cert-name {
    margin-top: 4%;
    font-family: var(--font-display);
    font-size: 0.72em;
    font-weight: 700;
  }

  .cert-rule {
    width: 62%;
    height: 1px;
    background: #c4bba7;
  }

  .cert-note {
    font-size: 0.44em;
    color: #5c6b66;
  }

  /* desk plates */
  /* Plates are kept short enough that the two above the chart sheet's edge sit
     fully clear of it — a plate sliced through the middle of its name reads as
     a bug, not as paper under paper. */
  .tags {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 3.5%;
  }

  .plate {
    display: grid;
    place-items: center;
    padding: 3.5% 0;
    border: 1px dashed #c4bba7;
    border-radius: 2px;
    font-family: var(--font-display);
    font-size: 0.78em;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  /* seating chart */
  .chart {
    display: flex;
    flex-direction: column;
    gap: 3%;
  }

  .sh-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    padding-bottom: 2%;
    border-bottom: 1px solid #c4bba7;
  }

  .sh-title {
    font-family: var(--font-display);
    font-size: 0.62em;
    font-weight: 800;
  }

  .sh-meta {
    font-size: 0.44em;
    color: #5c6b66;
  }

  .sh-room {
    flex: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4%;
  }

  .sh-group {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-content: center;
    gap: 5%;
    padding: 4%;
    border-radius: 4px;
    background: color-mix(in srgb, var(--tint) 13%, transparent);
  }

  .sh-desk {
    display: grid;
    place-items: center;
    min-height: 1.15em;
    padding: 0 0.1em;
    border: 1px solid #b9b0a0;
    border-radius: 2px;
    background: #fff;
    font-size: 0.4em;
    font-weight: 700;
    overflow: hidden;
    white-space: nowrap;
  }

  .sh-teacher {
    display: grid;
    place-items: center;
    width: 34%;
    margin-inline: auto;
    padding: 1% 0;
    border: 1px solid #b9b0a0;
    border-radius: 2px;
    background: #f3efe6;
    font-size: 0.4em;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .stack-chip {
    position: absolute;
    z-index: 3;
    left: 4%;
    bottom: -0.85rem;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--brand-strong);
    font-size: var(--text-xs);
    font-weight: 700;
    box-shadow: var(--shadow-1);
  }

  /* --- steps --------------------------------------------------------------- */
  .steps {
    margin-top: var(--space-7);
    padding-top: var(--space-6);
    border-top: var(--rule);
  }

  .steps h2 {
    font-size: var(--text-2xl);
    letter-spacing: -0.02em;
  }

  .steps ol {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-5) var(--space-6);
  }

  .steps li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  /* A hanging display figure, not a circled badge. */
  .num {
    flex: none;
    width: 1.6rem;
    font-family: var(--font-display);
    font-size: 1.9rem;
    font-weight: 800;
    line-height: 1;
    color: var(--accent);
  }

  .steps h3 {
    font-size: var(--text-lg);
    margin-bottom: 0.15rem;
  }

  .steps p {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }

  /* --- the tool index ------------------------------------------------------ */
  .suite {
    margin-top: var(--space-7);
    padding-top: var(--space-6);
    border-top: var(--rule);
    scroll-margin-top: 5.5rem;
  }

  .section-head {
    max-width: 42rem;
    margin-bottom: var(--space-6);
  }

  .section-head h2 {
    font-size: var(--text-3xl);
    letter-spacing: -0.025em;
  }

  .section-head p {
    margin-bottom: 0;
    color: var(--muted);
    font-size: var(--text-lg);
  }

  .group-label {
    margin: 0 0 var(--space-3);
    color: var(--muted);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .flagship {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5);
    border: var(--rule);
    border-radius: var(--radius-l);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    transition: border-color var(--motion-medium) ease, box-shadow var(--motion-medium) ease;
  }

  .flagship:hover {
    border-color: var(--brand);
    box-shadow: var(--shadow-1);
  }

  .fl-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-m);
    background: var(--brand);
    color: var(--on-brand);
  }

  .fl-body {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }

  .fl-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.2;
  }

  .fl-copy {
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .fl-go {
    flex: none;
    display: grid;
    place-items: center;
    margin-left: auto;
    color: var(--muted);
    transition: transform var(--motion-medium) var(--ease-standard), color var(--motion-medium) ease;
  }

  .flagship:hover .fl-go {
    transform: translateX(3px);
    color: var(--brand);
  }

  .variants {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.5rem;
    margin: var(--space-3) 0 0;
    padding-left: var(--space-1);
    font-size: var(--text-sm);
  }

  .variants span {
    color: var(--muted);
    font-weight: 700;
  }

  .variants a {
    padding: 0.25rem 0.6rem;
    border: var(--rule);
    border-radius: var(--radius-pill);
    color: var(--ink);
    text-decoration: none;
    transition: border-color var(--motion-fast) ease, background var(--motion-fast) ease;
  }

  .variants a:hover {
    border-color: color-mix(in srgb, var(--brand) 45%, var(--line));
    background: var(--brand-soft);
    color: var(--brand-strong);
  }

  .tool-group {
    margin-top: var(--space-6);
  }

  /* Rows, not cards: icon, name, one line of copy, and an arrow that steps out
     on hover. Three across on desktop so neither group leaves an orphan cell —
     "Split the class" is exactly one row, "Print & hand out" exactly two. */
  .tool-rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 var(--space-5);
  }

  .tool-rows a {
    display: grid;
    /* Every child is placed explicitly: an auto-placed item with a definite
       row would otherwise claim the name's column before the name gets it. */
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.2rem var(--space-3);
    height: 100%;
    padding: var(--space-4) var(--space-2);
    border-top: var(--rule);
    color: var(--ink);
    text-decoration: none;
    transition: background var(--motion-fast) ease;
  }

  .tool-rows a:hover {
    background: var(--surface-2);
  }

  /* Aligned to the name it labels, not floating between the two lines. */
  .row-icon {
    grid-column: 1;
    grid-row: 1 / 3;
    align-self: start;
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    color: var(--brand);
  }

  .row-name {
    grid-column: 2;
    grid-row: 1;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    line-height: 1.25;
  }

  .row-copy {
    grid-column: 2;
    grid-row: 2;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.45;
  }

  .row-go {
    grid-column: 3;
    grid-row: 1 / 3;
    display: grid;
    place-items: center;
    color: var(--muted);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity var(--motion-fast) ease, transform var(--motion-fast) var(--ease-standard);
  }

  .tool-rows a:hover .row-go,
  .tool-rows a:focus-visible .row-go {
    opacity: 1;
    transform: translateX(0);
  }

  /* --- why ----------------------------------------------------------------- */
  .why {
    margin-top: var(--space-7);
    padding-top: var(--space-6);
    border-top: var(--rule);
  }

  .why h2 {
    max-width: 30rem;
    font-size: var(--text-2xl);
    letter-spacing: -0.02em;
  }

  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-5) var(--space-6);
    margin-top: var(--space-5);
  }

  .cols h3 {
    font-size: var(--text-lg);
    margin-bottom: 0.3rem;
  }

