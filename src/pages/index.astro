---
import Icon from '../components/Icon.svelte';
import OwlMark from '../components/OwlMark.svelte';
import SiteFooter from '../components/SiteFooter.astro';
import Layout from '../layouts/Layout.astro';

const tools = [
  {
    href: '/seating-chart/',
    icon: 'grid',
    badge: 'Plan the room',
    title: 'Seating chart maker',
    copy: 'Rebuild your real room — table groups, stray pairs, gaps and all — set keep-apart rules, and shuffle. Prints perfectly on one page.',
  },
  {
    href: '/group-maker/',
    icon: 'users',
    badge: 'Build teams',
    title: 'Group maker',
    copy: 'Split the class into balanced groups that still honor your keep-apart rules.',
  },
  {
    href: '/picker/',
    icon: 'shuffle',
    badge: 'Call fairly',
    title: 'Student picker',
    copy: "Fair cold-calling: no repeats until everyone's had a turn, absent kids skipped.",
  },
  {
    href: '/certificates/',
    icon: 'sparkle',
    badge: 'Celebrate',
    title: 'Award certificates',
    copy: 'One click: a certificate for every student on your roster, as a single PDF.',
  },
  {
    href: '/checklist/',
    icon: 'check',
    badge: 'Track progress',
    title: 'Class checklist',
    copy: 'Names down the side, your columns across the top — the grid you keep rebuilding in Excel, in one click.',
  },
  {
    href: '/name-tags/',
    icon: 'tag',
    badge: 'Print once',
    title: 'Name tags & desk plates',
    copy: 'A tag for every student in one PDF — desk plates or Avery-style badge sheets, cut guides included.',
  },
  {
    href: '/jobs-chart/',
    icon: 'restore',
    badge: 'Share the work',
    title: 'Classroom jobs chart',
    copy: 'Assign class jobs and rotate fairly — every job changes hands, everyone gets equal turns.',
  },
  {
    href: '/bingo/',
    icon: 'hash',
    badge: 'Play together',
    title: 'Bingo cards',
    copy: "A unique card for every student from classmate names or your own word list — caller's list included.",
  },
  {
    href: '/flashcards/',
    icon: 'layers',
    badge: 'Drill & display',
    title: 'Flashcards & name cards',
    copy: 'Names or any word list as bold printable cards in three sizes — name jar, word wall, sight words.',
  },
  {
    href: '/attendance/',
    icon: 'printer',
    badge: 'Take the register',
    title: 'Attendance sheet',
    copy: "The month's real school days across the top, your class down the side — the register, rebuilt in one click.",
  },
] as const;

const miniGroups = [
  ['Ava', 'Liam', 'Zoë', 'Noah'],
  ['Maya', 'Ethan', 'Sofia', 'Kai'],
  ['Mia', 'Leo', 'Ruby', 'Omar'],
  ['Grace', 'Mateo', 'Nora', 'Jax'],
] as const;
---

<Layout
  title="RosterOwl — one roster, every classroom tool"
  description="Paste your class list once. Free seating charts, group makers and classroom printables — unlimited students, no signup, and student names never leave your browser."
>
  <main>
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">Private classroom tools for real teachers</p>
        <h1>One roster.<br />Every classroom tool.</h1>
        <p class="sub">
          Paste your class list once. Make seating charts that keep the chatty kids apart, shuffle
          groups, and print beautiful one-page PDFs — free, with unlimited students, and your
          students' names <strong>never leave your browser</strong>.
        </p>
        <div class="cta-row">
          <a class="btn primary large" href="/seating-chart/">
            Make your seating chart
            <Icon name="arrow-right" size={17} />
          </a>
          <a class="text-link" href="#tools">Explore all ten tools</a>
        </div>
        <ul class="trust">
          <li>No signup</li>
          <li>No watermark</li>
          <li>Unlimited classes</li>
          <li>Nothing uploaded</li>
        </ul>
      </div>

      <div class="product-preview" role="img" aria-label="Preview of a RosterOwl seating chart: Period 2, Room 12, four table groups of four students, all seating rules satisfied">
        <div class="preview-top">
          <OwlMark size={30} />
          <div>
            <strong>Period 2 · Room 12</strong>
            <span>24 students · saved only in this browser</span>
          </div>
          <span class="local-badge">Local</span>
        </div>
        <div class="mini-room" aria-hidden="true">
          {miniGroups.map((group) => (
            <div class="mini-group">
              {group.map((name) => (
                <span class="mini-desk">{name}</span>
              ))}
            </div>
          ))}
          <span class="mini-chip ok">
            <Icon name="check" size={13} /> All rules satisfied
          </span>
          <span class="mini-chip shuffle">
            <Icon name="shuffle" size={13} /> Shuffle
          </span>
        </div>
      </div>
    </section>

    <section class="how" aria-labelledby="how-heading">
      <h2 id="how-heading" class="sr-only">How RosterOwl works</h2>
      <ol>
        <li>
          <span class="step-num">1</span>
          <div>
            <h3>Paste your class list</h3>
            <p>Straight from your SIS, a spreadsheet, or an email — any format works.</p>
          </div>
        </li>
        <li>
          <span class="step-num">2</span>
          <div>
            <h3>Set your rules</h3>
            <p>Keep students apart or together, mark priority seating, match your real room.</p>
          </div>
        </li>
        <li>
          <span class="step-num">3</span>
          <div>
            <h3>Shuffle & print</h3>
            <p>Every tool reuses the same roster — one clean PDF whenever you need it.</p>
          </div>
        </li>
      </ol>
    </section>

    <section class="suite" id="tools">
      <div class="section-head">
        <p class="eyebrow">Your roster, already ready</p>
        <h2>Ten useful tools. Zero repeated setup.</h2>
        <p>Move from planning to printing without typing the same names twice.</p>
      </div>
      <div class="cards">
        {tools.map((tool) => (
          <a class="card" href={tool.href}>
            <span class="card-icon"><Icon name={tool.icon} size={20} /></span>
            <span class="badge">{tool.badge}</span>
            <h3>{tool.title}</h3>
            <p>{tool.copy}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="why">
      <h2>Built the way school data should be handled</h2>
      <div class="cols">
        <div>
          <h3>Names stay on your device</h3>
          <p>
            RosterOwl does its work inside your browser. Your class list is saved on your own
            computer — no accounts, no servers, nothing for anyone to breach.
            <a href="/privacy/">See exactly what this site sends.</a>
          </p>
        </div>
        <div>
          <h3>Genuinely free</h3>
          <p>
            No 25-student cap, no watermark stamped over your chart, no "premium" wall in front of
            the feature you actually need. The core tools stay free — that's the point of the
            project.
          </p>
        </div>
        <div>
          <h3>Readable by design</h3>
          <p>
            Set in Atkinson Hyperlegible, a typeface designed by the Braille Institute for readers
            with low vision — on screen and on every printed chart.
          </p>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter note="free classroom tools" />
</Layout>

<style>
  main {
    max-width: var(--content-wide);
    margin: 0 auto;
    padding: 0 var(--page-gutter) var(--space-7);
  }
  .hero {
    padding: clamp(3rem, 7vw, 6rem) 0 var(--space-7);
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.9fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
  }
  .hero-copy {
    max-width: 44rem;
  }
  .eyebrow {
    margin: 0 0 var(--space-3);
    color: var(--brand-strong);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }
  h1 {
    font-size: var(--text-display);
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--ink);
  }
  .sub {
    font-size: 1.15rem;
    color: var(--muted);
    max-width: 38rem;
    margin: var(--space-4) 0 var(--space-5);
  }
  .sub strong {
    color: var(--ink);
  }
  .cta-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  .text-link {
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 2px solid color-mix(in srgb, var(--brand) 40%, transparent);
    transition: color var(--motion-fast) ease, border-color var(--motion-fast) ease;
  }
  .text-link:hover {
    color: var(--brand);
    border-bottom-color: var(--brand);
  }
  .trust {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
    padding: 0;
    margin: var(--space-5) 0 0;
    color: var(--muted);
    font-weight: 700;
    font-size: 0.92rem;
  }
  .trust li::before {
    content: '✓ ';
    color: var(--ok);
  }

  /* --- hero product mock ------------------------------------------------- */
  .product-preview {
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background: var(--surface);
    box-shadow: var(--shadow-2);
    padding: var(--space-4);
  }
  .preview-top {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-1) var(--space-1) var(--space-4);
  }
  .preview-top strong,
  .preview-top span {
    display: block;
  }
  .preview-top > div > span {
    color: var(--muted);
    font-size: var(--text-xs);
  }
  .local-badge {
    border-radius: var(--radius-pill);
    background: var(--brand-soft);
    color: var(--brand-strong);
    padding: 0.25rem 0.6rem;
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .mini-room {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-4) var(--space-6);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--canvas-bg);
    background-image: radial-gradient(var(--canvas-dot) 1.2px, transparent 1.2px);
    background-size: 22px 22px;
  }
  .mini-group {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    padding: 8px;
    border-radius: var(--radius-m);
    background: color-mix(in srgb, var(--g-blue) 10%, transparent);
  }
  .mini-group:nth-child(2) {
    background: color-mix(in srgb, var(--g-coral) 10%, transparent);
  }
  .mini-group:nth-child(3) {
    background: color-mix(in srgb, var(--g-violet) 10%, transparent);
  }
  .mini-group:nth-child(4) {
    background: color-mix(in srgb, var(--g-gold) 10%, transparent);
  }
  .mini-desk {
    display: grid;
    place-items: center;
    min-height: 2.1rem;
    padding: 0.15rem 0.3rem;
    background: var(--desk-fill);
    border: 1.5px solid var(--desk-line);
    border-radius: 7px;
    box-shadow: var(--shadow-1);
    font-size: 0.72rem;
    font-weight: 700;
  }
  .mini-chip {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    border-radius: var(--radius-pill);
    padding: 0.3rem 0.7rem;
    font-size: var(--text-xs);
    font-weight: 700;
    box-shadow: var(--shadow-2);
  }
  .mini-chip.ok {
    left: var(--space-3);
    bottom: -0.8rem;
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--ok);
  }
  .mini-chip.shuffle {
    right: var(--space-3);
    bottom: -0.8rem;
    background: var(--brand);
    border: 1px solid var(--brand);
    color: var(--on-brand);
  }

  /* --- how it works ------------------------------------------------------ */
  .how ol {
    list-style: none;
    margin: 0;
    padding: var(--space-5);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background: var(--surface);
  }
  .how li {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }
  .step-num {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    background: var(--brand-soft);
    color: var(--brand-strong);
    font-family: var(--font-display);
    font-weight: 800;
  }
  .how h3 {
    font-size: var(--text-base);
    margin-bottom: 0.15rem;
  }
  .how p {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }

  /* --- tool cards -------------------------------------------------------- */
  .suite {
    margin-top: var(--space-8);
  }
  section h2 {
    font-size: var(--text-2xl);
    margin: 0;
  }
  .section-head {
    max-width: 42rem;
    margin-bottom: var(--space-5);
  }
  .section-head > p:last-child {
    color: var(--muted);
    font-size: var(--text-lg);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--space-4);
  }
  /* On desktop the ten tools sit in exactly two rows of five. */
  @media (min-width: 1150px) {
    .cards {
      grid-template-columns: repeat(5, 1fr);
    }
    .card {
      padding: var(--space-4);
    }
    .card h3 {
      font-size: var(--text-lg);
    }
  }
  .card {
    position: relative;
    display: block;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    padding: var(--space-5);
    text-decoration: none;
    color: var(--ink);
    transition:
      transform var(--motion-medium) var(--ease-standard),
      box-shadow var(--motion-medium) ease,
      border-color var(--motion-medium) ease;
  }
  .card:hover,
  .card:focus-visible {
    border-color: var(--brand);
    box-shadow: var(--shadow-2);
    transform: translateY(-3px);
  }
  .card-icon {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: var(--radius-m);
    background: var(--brand-soft);
    color: var(--brand-strong);
    margin-bottom: var(--space-3);
    transition: background var(--motion-medium) ease, color var(--motion-medium) ease;
  }
  .card:hover .card-icon {
    background: var(--brand);
    color: var(--on-brand);
  }
  .badge {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--brand);
  }
  .card h3 {
    font-size: var(--text-xl);
    margin: 0.2rem 0 0.4rem;
  }
  .card p {
    color: var(--muted);
    font-size: 0.95rem;
    margin: 0;
  }

  /* --- why section -------------------------------------------------------- */
  .why {
    margin-top: var(--space-8);
    padding: var(--space-7);
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background: var(--surface-2);
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-4);
  }
  .cols h3 {
    font-size: 1.1rem;
    margin-bottom: 0.4rem;
  }
  .cols p {
    color: var(--muted);
    font-size: 0.97rem;
  }

  @media (max-width: 800px) {
    .hero {
      grid-template-columns: 1fr;
      padding-top: var(--space-7);
    }
    .product-preview {
      max-width: 36rem;
    }
  }
  @media (max-width: 520px) {
    .hero {
      padding-top: var(--space-6);
      padding-bottom: var(--space-7);
    }
    .trust {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .why {
      padding: var(--space-5);
    }
    .suite {
      margin-top: var(--space-7);
    }
  }
</style>
