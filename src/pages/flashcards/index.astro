---
import Layout from '../../layouts/Layout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import FlashcardsApp from '../../components/FlashcardsApp.svelte';
import { toolJsonLd, faqJsonLd } from '../../lib/seo';

const jsonLd = toolJsonLd({
  name: 'RosterOwl Flashcard Maker',
  path: '/flashcards/',
  description:
    'Big printable flashcards from your class list or any word list: name-wall cards, name-jar sticks, sight words, vocab. Three sizes with cut guides, one PDF. Free, no signup — nothing leaves your browser.',
});

// Mirrors the visible <section class="faq"> below, verbatim (inline <strong> stripped).
const faqLd = faqJsonLd([
  {
    q: `Which size should I use for what?`,
    a: `Jumbo (2 per page) reads from across the room — word walls, name-jar sticks, pocket-chart headers. Classic (4 per page) is the standard drill flashcard for small groups. Pocket (8 per page) makes ring cards and center-station decks. All three print with dashed cut guides.`,
  },
  {
    q: `I repeated a word on purpose — does it stay repeated?`,
    a: `Yes. Every line in your list becomes its own card, duplicates included — handy when a sight-word deck needs "the" three times, or a game needs matching pairs.`,
  },
  {
    q: `Is my word list saved?`,
    a: `Yes — it's stored with your class, in your browser on your device only, and it's back the next time you open this page. Nothing is uploaded anywhere.`,
  },
]);
---

<Layout
  title="Flashcard Maker — Names & Word Lists | RosterOwl"
  description="Print big flashcards in one click: every student's name as a card set (name jar, word wall, sub's cheat sheet) or any word list — sight words, vocab, math facts. Three sizes, dashed cut guides, one PDF. Free, no signup, no watermark."
>
  <script is:inline type="application/ld+json" set:html={jsonLd} slot="head" />
  <script is:inline type="application/ld+json" set:html={faqLd} slot="head" />

  <main class="tool-page">
    <div class="page-head">
      <h1>Flashcard maker</h1>
      <p>
        The whole class as a card set in one click — name jar, word wall, sub's cheat sheet — or
        paste any word list: sight words, vocab, math facts. Three sizes, cut guides, one PDF.
        Free · no signup · <a href="/privacy/">names never leave your browser</a>.
      </p>
    </div>

    <FlashcardsApp client:only="svelte" />

    <section class="content">
      <h2 class="sr-only">Why teachers use it</h2>
      <div class="feature-grid">
        <div>
          <h3>The whole class in one click</h3>
          <p>
            Every student's name becomes a card — no name typed twice. Cut jumbo cards in half
            for name-jar sticks, pin them up as a word wall, or leave the stack on your desk as
            the sub's cheat sheet.
          </p>
        </div>
        <div>
          <h3>Any word list too</h3>
          <p>
            Switch to your own list and paste anything, one card per line: sight words, spelling
            lists, vocabulary, math facts, discussion questions. The list saves with your class,
            ready to reprint.
          </p>
        </div>
        <div>
          <h3>Three sizes, cut and go</h3>
          <p>
            Jumbo (2 per page) for walls and jars, classic (4 per page) for drills, pocket
            (8 per page) for card rings and centers. Dashed cut guides on every sheet; text
            auto-sizes so long words still fit.
          </p>
        </div>
        <div>
          <h3>Private by architecture</h3>
          <p>Runs entirely in your browser. No accounts, no uploads, nothing stored anywhere but your device.</p>
        </div>
      </div>

      <section class="faq">
        <h2>Questions teachers ask</h2>
        <details>
          <summary>Which size should I use for what?</summary>
          <p>
            <strong>Jumbo</strong> (2 per page) reads from across the room — word walls, name-jar
            sticks, pocket-chart headers. <strong>Classic</strong> (4 per page) is the standard
            drill flashcard for small groups. <strong>Pocket</strong> (8 per page) makes ring
            cards and center-station decks. All three print with dashed cut guides.
          </p>
        </details>
        <details>
          <summary>I repeated a word on purpose — does it stay repeated?</summary>
          <p>
            Yes. Every line in your list becomes its own card, duplicates included — handy when a
            sight-word deck needs "the" three times, or a game needs matching pairs.
          </p>
        </details>
        <details>
          <summary>Is my word list saved?</summary>
          <p>
            Yes — it's stored with your class, in your browser on your device only, and it's back
            the next time you open this page. Nothing is uploaded anywhere.
          </p>
        </details>
      </section>
    </section>
  </main>

  <SiteFooter />
</Layout>
