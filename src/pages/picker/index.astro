---
import Layout from '../../layouts/Layout.astro';
import Faq from '../../components/Faq.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import MoreTools from '../../components/MoreTools.astro';
import PickerApp from '../../components/PickerApp.svelte';
import { toolJsonLd, type FaqEntry } from '../../lib/seo';

const jsonLd = toolJsonLd({
  name: 'RosterOwl Student Picker',
  path: '/picker/',
  description:
    'Fair random student picker for teachers: no repeats until everyone has had a turn, absent students skipped automatically. Free, no signup — nothing uploaded unless you turn on sync.',
});

const faqs: FaqEntry[] = [
  {
    q: `What happens when everyone's been picked?`,
    a: `A new round starts automatically (with a little note so you know), and the counter resets. You can also reset the round yourself any time.`,
  },
  {
    q: `Does it remember the round if I close the tab?`,
    a: `Yes — round progress is saved in your browser with the rest of your class data, so Monday's round continues on Tuesday if you want it to.`,
  },
  {
    q: `Can I use it on the projector?`,
    a: `That's the idea — the picked name fills the screen, and the space bar picks the next student so you can do it from the keyboard. There's a chalkboard dark mode, too.`,
  },
];
---

<Layout
  title="Fair Random Student Picker — No Repeats | RosterOwl"
  description="Pick students fairly: no repeats until everyone has had a turn, absent students skipped automatically, round progress you can show the class. Uses the same class list as your seating chart. Free, no signup — nothing uploaded unless you turn on sync."
>
  <script is:inline type="application/ld+json" set:html={jsonLd} slot="head" />

  <main class="tool-page">
    <div class="page-head">
      <h1>Random student picker</h1>
      <p>
        Fair cold-calling: nobody gets picked twice until everyone's had a turn, and absent
        students are skipped automatically. Free · no signup ·
        <a href="/privacy/">nothing uploaded unless you turn on sync</a>.
      </p>
    </div>

    <PickerApp client:only="svelte" />

    <section class="content">
      <h2 class="sr-only">Why this picker is fair</h2>
      <div class="feature-grid">
        <div>
          <h3>Actually fair</h3>
          <p>
            A plain name wheel can call the same student three times in a row. RosterOwl tracks the
            round: everyone gets exactly one turn before anyone gets a second — and the class can
            see the progress bar prove it.
          </p>
        </div>
        <div>
          <h3>Absence-aware</h3>
          <p>
            Marked someone absent in the seating chart this morning? The picker skips them
            automatically — no awkward "oh, they're not here."
          </p>
        </div>
        <div>
          <h3>One roster, shared</h3>
          <p>
            No retyping 28 names into a wheel. Your class list is already here, shared with the
            seating chart and group maker.
          </p>
        </div>
        <div>
          <h3>Private by architecture</h3>
          <p>Runs entirely in your browser. No accounts, no uploads, nothing stored anywhere but your device.</p>
        </div>
      </div>

      <Faq entries={faqs} />
    </section>
    <MoreTools />
  </main>

  <SiteFooter />
</Layout>

