---
// The "what next" band every tool page ends with. Reads the shared tool table
// and drops whichever tool the reader is already on, so it never links to the
// current page and never needs updating when a tool is added.
import Icon from './Icon.svelte';
import { ALL_TOOLS, PRINTABLES, SEATING_VARIANTS, activeToolHref } from '../lib/tools';

interface Props {
  /** Heading override, for pages where the default reads oddly. */
  heading?: string;
}
const { heading = 'One roster, every other tool' } = Astro.props;

const pathname = Astro.url.pathname;
const current = activeToolHref(pathname);
const others = ALL_TOOLS.filter((t) => t.href !== current);
// The seating pages already cross-link their own variants in body copy.
const showVariants = current !== '/seating-chart/';
---

<section class="more-tools" aria-labelledby="more-tools-heading">
  <div class="mt-head">
    <h2 id="more-tools-heading">{heading}</h2>
    <p>
      Your class list is already saved in this browser — every tool below picks it up, with no
      names retyped and nothing uploaded.
    </p>
  </div>

  <ul>
    {others.map((tool) => (
      <li>
        <a href={tool.href}>
          <span class="mt-icon"><Icon name={tool.icon} size={17} /></span>
          <span class="mt-name">{tool.title}</span>
          <span class="mt-blurb">{tool.blurb}</span>
          <span class="mt-go" aria-hidden="true"><Icon name="arrow-right" size={15} /></span>
        </a>
      </li>
    ))}
  </ul>

  {showVariants && (
    <p class="mt-variants">
      <span>Ready to print:</span>
      {[...SEATING_VARIANTS, PRINTABLES].map((v) => (
        <a href={v.href}>{v.label}</a>
      ))}
    </p>
  )}
</section>

<style>
  .more-tools {
    width: min(100%, var(--content-wide));
    margin: var(--space-8) auto 0;
    padding-top: var(--space-6);
    border-top: var(--rule);
  }

  .mt-head {
    max-width: 42rem;
    margin-bottom: var(--space-5);
  }

  .more-tools h2 {
    font-size: var(--text-2xl);
    letter-spacing: -0.02em;
  }

  .mt-head p {
    margin-bottom: 0;
    color: var(--muted);
  }

  /* Three across leaves no orphan cell for nine tools. */
  .more-tools ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 var(--space-5);
  }

  .more-tools a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.2rem var(--space-3);
    height: 100%;
    padding: var(--space-3) var(--space-2);
    border-top: var(--rule);
    color: var(--ink);
    text-decoration: none;
    transition: background var(--motion-fast) ease;
  }

  .more-tools a:hover {
    background: var(--surface-2);
  }

  .mt-icon {
    grid-column: 1;
    grid-row: 1 / 3;
    align-self: start;
    display: grid;
    place-items: center;
    width: 1.7rem;
    height: 1.7rem;
    color: var(--brand);
  }

  .mt-name {
    grid-column: 2;
    grid-row: 1;
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 700;
    line-height: 1.3;
  }

  .mt-blurb {
    grid-column: 2;
    grid-row: 2;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.4;
  }

  .mt-go {
    grid-column: 3;
    grid-row: 1 / 3;
    display: grid;
    place-items: center;
    color: var(--muted);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity var(--motion-fast) ease, transform var(--motion-fast) var(--ease-standard);
  }

  .more-tools a:hover .mt-go,
  .more-tools a:focus-visible .mt-go {
    opacity: 1;
    transform: translateX(0);
  }

  .mt-variants {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.5rem;
    margin: var(--space-5) 0 0;
    padding-top: var(--space-4);
    border-top: var(--rule);
    font-size: var(--text-sm);
  }

  .mt-variants > span {
    color: var(--muted);
    font-weight: 700;
  }

  .mt-variants a {
    display: inline-block;
    padding: 0.25rem 0.6rem;
    border: var(--rule);
    border-radius: var(--radius-pill);
    color: var(--ink);
    text-decoration: none;
    transition: border-color var(--motion-fast) ease, background var(--motion-fast) ease;
  }

  .mt-variants a:hover {
    border-color: color-mix(in srgb, var(--brand) 45%, var(--line));
    background: var(--brand-soft);
    color: var(--brand-strong);
  }

  @media (max-width: 1000px) {
    .more-tools ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    .more-tools ul {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
