---
import OwlMark from './OwlMark.svelte';
import { PRINTABLES, SEATING, SEATING_VARIANTS, TOOL_GROUPS } from '../lib/tools';
import { SITE_PAGES } from '../lib/site';

interface Props {
  note?: string;
}
const { note } = Astro.props;
const year = new Date().getFullYear();

// Same three groups as the header panel and the landing index. The seating
// column carries its pre-configured pages too, so every page links to them.
const [, ...otherGroups] = TOOL_GROUPS;
const planLinks = [
  { href: SEATING.href, label: SEATING.title },
  ...SEATING_VARIANTS.map((v) => ({ href: v.href, label: v.label })),
  { href: PRINTABLES.href, label: PRINTABLES.label },
];
const columns = [
  { key: 'plan', label: 'Plan the room', links: planLinks },
  ...otherGroups.map((g) => ({
    key: g.key,
    label: g.label,
    links: g.tools.map((t) => ({ href: t.href, label: t.title })),
  })),
];
---

<footer class="site-foot">
  <div class="foot-inner">
    <div class="foot-brand">
      <a class="foot-mark" href="/" aria-label="RosterOwl home">
        <OwlMark size={28} />
        <span>RosterOwl</span>
      </a>
      <p class="foot-tagline">
        One roster, every classroom tool. Free, no signup — nothing uploaded unless you turn on sync.
      </p>
      <a class="foot-privacy" href="/privacy/">How privacy works →</a>
    </div>
    {columns.map((col) => (
      <nav class="foot-col" aria-label={col.label}>
        <h2>{col.label}</h2>
        <ul>
          {col.links.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </nav>
    ))}
  </div>
  <div class="foot-base">
    <span>© {year} RosterOwl · made for teachers{note ? ` · ${note}` : ''}</span>
    <nav class="foot-pages" aria-label="About this site">
      {
        SITE_PAGES.map((p) => (
          <a href={p.href} aria-current={Astro.url.pathname === p.href ? 'page' : undefined}>
            {p.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>

<style>
  .site-foot {
    border-top: var(--rule);
    background: var(--surface);
    padding: var(--space-6) var(--page-gutter) var(--space-5);
    text-align: left;
    font-size: var(--text-sm);
  }

  .foot-inner {
    width: min(100%, var(--content-wide));
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(14rem, 1.3fr) repeat(3, minmax(0, 1fr));
    gap: var(--space-5) var(--space-6);
  }

  .foot-mark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 800;
    text-decoration: none;
  }

  .foot-tagline {
    color: var(--muted);
    max-width: 22rem;
    margin: var(--space-3) 0;
  }

  .foot-privacy {
    font-weight: 700;
    text-decoration: none;
  }

  .foot-privacy:hover {
    text-decoration: underline;
  }

  .foot-col h2 {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: var(--space-3);
  }

  .foot-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  .foot-col a {
    color: var(--ink);
    text-decoration: none;
  }

  .foot-col a:hover {
    color: var(--brand);
    text-decoration: underline;
  }

  .foot-base {
    width: min(100%, var(--content-wide));
    margin: var(--space-6) auto 0;
    padding-top: var(--space-4);
    border-top: var(--rule);
    color: var(--muted);
    font-size: var(--text-xs);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
  }

  /* About / Privacy / Contact / Terms — the header hides its nav links on
     narrow screens, so this row is the only reliable path to them on a phone. */
  .foot-pages {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .foot-pages a {
    color: var(--muted);
    text-decoration: none;
  }

  .foot-pages a:hover {
    color: var(--brand);
    text-decoration: underline;
  }

  .foot-pages a[aria-current='page'] {
    color: var(--ink);
    font-weight: 700;
  }

  @media (max-width: 940px) {
    .foot-inner {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .foot-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 620px) {
    .foot-inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
