---
import '../styles/global.css';
import Icon from '../components/Icon.svelte';
import OwlMark from '../components/OwlMark.svelte';
import { PRINTABLES, SEATING, TOOL_GROUPS, activeToolHref } from '../lib/tools';
import { SITE_PAGES } from '../lib/site';
import { SITE_URL, ogImageFor } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  /** Error pages: no canonical (the URL is not a real route) and no indexing. */
  noindex?: boolean;
  /** Site-absolute path to a card image. Defaults to this page's own, or /og.png. */
  ogImage?: string;
}
const { title, description, noindex = false, ogImage } = Astro.props;
const pathname = Astro.url.pathname;
const canonical = `${SITE_URL}${pathname}`;
const card = `${SITE_URL}${ogImage ?? ogImageFor(pathname)}`;
// Titles already end in "| RosterOwl"; the card art already says it too, so the
// alt text drops the suffix instead of saying the brand three times.
const cardAlt = title.replace(/\s*[|—–-]\s*RosterOwl\s*$/, '');
// Cloudflare Web Analytics: cookieless page counts, no consent banner needed.
// Absent from local and preview builds so development is never counted — set
// PUBLIC_CF_BEACON_TOKEN for production, where /privacy/ says it is running.
const beaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
// Google Analytics 4, for funnels Cloudflare's cookieless counter cannot show
// (how many people who open a tool actually download a PDF). Unlike the beacon
// it sets cookies, so it is gated behind consent and loads only on acceptance —
// see the consent bar near the end of <body>. Same deploy-only wiring as the
// beacon: local builds and CI never carry it.
const gaId = import.meta.env.PUBLIC_GA_ID;
const isHome = pathname === '/';
const activeTool = activeToolHref(pathname);
// The flagship leads the panel on its own; the rest fill the two columns below.
const [planGroup, ...otherGroups] = TOOL_GROUPS;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#faf7f0" />
    <meta name="apple-mobile-web-app-title" content="RosterOwl" />
    <meta name="application-name" content="RosterOwl" />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <link rel="canonical" href={canonical} />
    )}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="RosterOwl" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={card} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={cardAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={card} />
    <meta name="twitter:image:alt" content={cardAlt} />
    <link
      rel="preload"
      href="/fonts/AtkinsonHyperlegible-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Baloo2-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      // Apply saved theme before paint to avoid a flash. Light paper is the
      // default; dark chalkboard only when the teacher explicitly chose it.
      try {
        let theme = null;
        const raw = localStorage.getItem('rosterowl:v1');
        if (raw) theme = JSON.parse(raw)?.settings?.theme ?? null;
        if (theme !== 'dark' && theme !== 'light') {
          theme = localStorage.getItem('rosterowl:theme');
        }
        if (theme === 'dark') {
          document.documentElement.dataset.theme = 'dark';
          document.querySelector('meta[name="theme-color"]')?.setAttribute('content', '#141d1a');
        }
      } catch {}
      // Reveal the local-data strip before first paint so the sticky header
      // does not jump. Signed-in teachers and anyone who dismissed it stay
      // without the extra row.
      try {
        const signedIn = /(^|;\s*)ro_signed_in=1(;|$)/.test(document.cookie);
        if (!signedIn && localStorage.getItem('rosterowl:local-warning-dismissed') !== '1') {
          document.documentElement.dataset.localWarn = '';
        }
      } catch {}
    </script>
    {
      beaconToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: beaconToken })}
        />
      )
    }
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <div class="sw-update" hidden data-sw-update role="status">
      <span>A new version of RosterOwl is ready.</span>
      <button class="btn small primary" type="button" data-sw-reload>Reload</button>
      <button class="icon-btn" type="button" data-sw-dismiss aria-label="Dismiss">
        <Icon name="close" size={14} />
      </button>
    </div>
    <header class="site-shell">
      <div class="local-warn" data-local-warn-bar role="status">
        <div class="local-warn__inner">
          <span class="warn-icon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16">
              <circle cx="8" cy="8" r="8" fill="currentColor" />
              <path
                d="M8 4.15v5.1"
                fill="none"
                stroke="#fff"
                stroke-width="1.85"
                stroke-linecap="round"
              />
              <circle cx="8" cy="11.55" r="1.05" fill="#fff" />
            </svg>
          </span>
          <p>
            Until you sign in, everything stays in this browser — you may lose it.
            <a class="warn-action" href="/api/auth/google/start" data-warn-signin>Sign in to keep it.</a>
          </p>
          <button class="warn-dismiss" type="button" data-warn-dismiss aria-label="Dismiss this notice">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
              <path d="M18 6 6 18M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>
      <div class="site-shell__inner">
        <a
          class="site-brand"
          href="/"
          aria-label="RosterOwl home"
          aria-current={isHome ? 'page' : undefined}
        >
          <OwlMark size={32} />
          <span>RosterOwl</span>
        </a>

        <nav class="site-nav" aria-label="Classroom tools">
          <details class="tools-menu" data-tools-menu>
            <summary aria-current={activeTool ? 'page' : undefined}>
              Tools
              <svg
                class="caret"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg
              >
            </summary>

            <div class="tools-panel">
              <div class="panel-lead">
                <p class="group-label">{planGroup.label}</p>
                <a class="flagship" href={SEATING.href} aria-current={activeTool === SEATING.href ? 'page' : undefined}>
                  <span class="t-icon"><Icon name={SEATING.icon} size={20} /></span>
                  <span class="t-text">
                    <span class="t-name">{SEATING.title}</span>
                    <span class="t-blurb">{SEATING.blurb}</span>
                  </span>
                  <Icon name="arrow-right" size={16} />
                </a>
              </div>

              <div class="panel-cols">
                {otherGroups.map((group) => (
                  <div class:list={['panel-group', `is-${group.key}`]}>
                    <p class="group-label">{group.label}</p>
                    <ul>
                      {group.tools.map((tool) => (
                        <li>
                          <a href={tool.href} aria-current={activeTool === tool.href ? 'page' : undefined}>
                            <span class="t-icon"><Icon name={tool.icon} size={17} /></span>
                            <span class="t-text">
                              <span class="t-name">{tool.label}</span>
                              <span class="t-blurb">{tool.blurb}</span>
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>

              <div class="panel-foot">
                <p>
                  Every tool reads the same class list — paste it once. Nothing is uploaded unless
                  you turn on sync.
                </p>
                {/* Below 900px the header's own nav links are hidden, and until
                    now the footer was the only way to reach these — a long
                    scroll past a whole tool on a phone. Shown only at the width
                    where the nav drops them, so the desktop panel stays clean. */}
                <nav class="panel-pages" aria-label="More pages">
                  {[PRINTABLES, ...SITE_PAGES].map((p) => (
                    <a href={p.href} aria-current={pathname.startsWith(p.href) ? 'page' : undefined}>
                      {p.label}
                    </a>
                  ))}
                </nav>
              </div>
            </div>
          </details>

          <a
            class="nav-link"
            href="/printables/"
            aria-current={pathname.startsWith('/printables') ? 'page' : undefined}
          >
            Printables
          </a>
          <a
            class="nav-link"
            href="/privacy/"
            aria-current={pathname.startsWith('/privacy') ? 'page' : undefined}
          >
            Privacy Policy
          </a>
        </nav>

        <div class="site-actions">
          <a class="class-chip" href={SEATING.href} hidden data-class-chip>
            <span class="chip-dot" aria-hidden="true"></span>
            <span class="chip-text" data-class-name></span>
            <span class="chip-count" data-class-count></span>
          </a>
          <a class="signin" href="/api/auth/google/start" data-signin>
            <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
              <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.92c1.7-1.57 2.68-3.88 2.68-6.62z"/>
              <path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.92-2.26c-.8.54-1.84.86-3.04.86-2.34 0-4.32-1.58-5.03-3.7H.96v2.33A9 9 0 0 0 9 18z"/>
              <path fill="#FBBC05" d="M3.97 10.72a5.4 5.4 0 0 1 0-3.44V4.95H.96a9 9 0 0 0 0 8.1l3.01-2.33z"/>
              <path fill="#EA4335" d="M9 3.58c1.32 0 2.5.45 3.44 1.35l2.58-2.58C13.46.9 11.43 0 9 0A9 9 0 0 0 .96 4.95l3.01 2.33C4.68 5.16 6.66 3.58 9 3.58z"/>
            </svg>
            <span>Sign in</span>
          </a>
          <button
            class="theme-toggle"
            type="button"
            aria-pressed="false"
            aria-label="Switch to dark chalkboard theme"
            title="Switch to dark chalkboard theme"
          >
            <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20.5 14.5A8.5 8.5 0 1 1 9.5 3.5a7 7 0 0 0 11 11z" />
            </svg>
            <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8zM12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
          </button>
        </div>
      </div>
    </header>
    <script is:inline>
      // Runs immediately after the header markup, so the chip is filled in the
      // same parse pass — it appears with the header rather than shifting it
      // later. Reads localStorage directly: importing appState here would pull
      // the whole tool bundle onto pages that ship no JavaScript at all.
      (() => {
        const chip = document.querySelector('[data-class-chip]');
        if (!chip) return;
        // Already on the seating chart — the chip would only link here.
        const onSeating = location.pathname.startsWith('/seating-chart');
        const render = (cls) => {
          if (onSeating || !cls || !cls.name || !String(cls.name).trim()) {
            chip.hidden = true;
            return;
          }
          const name = String(cls.name).trim();
          const count = Number(cls.count) || 0;
          chip.querySelector('[data-class-name]').textContent = name;
          chip.querySelector('[data-class-count]').textContent = String(count);
          chip.setAttribute(
            'aria-label',
            `Current class: ${name}, ${count} student${count === 1 ? '' : 's'}. Open the seating chart.`
          );
          chip.hidden = false;
        };
        try {
          const state = JSON.parse(localStorage.getItem('rosterowl:v1') || 'null');
          const classes = state && state.classes;
          if (Array.isArray(classes) && classes.length) {
            const cls = classes.find((c) => c && c.id === state.activeClassId) ?? classes[0];
            // The seeded demo class is not the teacher's own — don't advertise it.
            if (cls && cls.id !== 'sample-class') {
              render({ name: cls.name, count: Array.isArray(cls.students) ? cls.students.length : 0 });
            }
          }
        } catch {}
        // Switching or renaming a class in a tool re-renders the chip in place.
        window.addEventListener('rosterowl-class-change', (e) => render(e.detail));
      })();
    </script>
    <script is:inline>
      // The header's sign-in link. Rendered as a plain anchor so it works with
      // no JavaScript and costs no Svelte island on the static pages; this only
      // sharpens it.
      //
      // Two adjustments. First, come back to the page the teacher was reading
      // rather than the Worker's default landing spot — the Worker validates
      // `next` as a same-origin path, so an open redirect is not on the table.
      // Second, stand down once they are signed in: ro_signed_in is a
      // non-HttpOnly hint cookie set beside the real session, so the header can
      // read it without an API call on every page. The sync menu inside the
      // tools owns the signed-in state — account, last sync, sign out — and two
      // controls disagreeing about it would be worse than one.
      (() => {
        const signedIn = /(^|;\s*)ro_signed_in=1(;|$)/.test(document.cookie);
        const next = '/api/auth/google/start?next=' + encodeURIComponent(location.pathname + location.search);

        const link = document.querySelector('[data-signin]');
        if (link) {
          if (signedIn) link.hidden = true;
          else link.href = next;
        }

        // The "this is only in your browser" strip. Visibility is decided in
        // the head script (data-local-warn on <html>) so the sticky header
        // does not jump. This pass only points Sign-in back here and wires
        // dismiss. Signed-in teachers never see it — the hint cookie stands
        // the strip down on the next load.
        const warn = document.querySelector('[data-local-warn-bar]');
        if (!warn) return;
        if (signedIn) {
          delete document.documentElement.dataset.localWarn;
          return;
        }
        const signin = warn.querySelector('[data-warn-signin]');
        if (signin) signin.href = next;
        warn.querySelector('[data-warn-dismiss]')?.addEventListener('click', () => {
          delete document.documentElement.dataset.localWarn;
          try {
            localStorage.setItem('rosterowl:local-warning-dismissed', '1');
          } catch {}
        });
      })();
    </script>
    <div id="main-content" tabindex="-1">
      <slot />
    </div>
    <script is:inline>
      (() => {
        const button = document.querySelector('.theme-toggle');
        if (!(button instanceof HTMLButtonElement)) return;
        const updateLabel = () => {
          const dark = document.documentElement.dataset.theme === 'dark';
          const label = dark ? 'Switch to light paper theme' : 'Switch to dark chalkboard theme';
          // Tooltip and accessible name must agree — they used to diverge once
          // the theme was toggled.
          button.setAttribute('aria-label', label);
          button.setAttribute('title', label);
          button.setAttribute('aria-pressed', dark ? 'true' : 'false');
          // Browser chrome follows the applied theme, not the OS preference.
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute('content', dark ? '#141d1a' : '#faf7f0');
        };
        updateLabel();
        button.addEventListener('click', () => {
          const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          if (next === 'dark') document.documentElement.dataset.theme = 'dark';
          else delete document.documentElement.dataset.theme;
          try {
            // Standalone key so the choice survives even before any class exists.
            localStorage.setItem('rosterowl:theme', next);
            const raw = localStorage.getItem('rosterowl:v1');
            const state = raw ? JSON.parse(raw) : null;
            if (state?.settings) {
              state.settings.theme = next;
              localStorage.setItem('rosterowl:v1', JSON.stringify(state));
            }
          } catch {}
          window.dispatchEvent(new CustomEvent('rosterowl-theme-change', { detail: next }));
          updateLabel();
        });
        // Keep the icon/label right if a Svelte island changes the theme.
        new MutationObserver(updateLabel).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['data-theme'],
        });

        // The tools panel closes on outside click, on Escape, and once a link
        // inside it is followed (which matters for same-page anchors).
        const menu = document.querySelector('[data-tools-menu]');
        if (menu instanceof HTMLDetailsElement) {
          document.addEventListener('pointerdown', (e) => {
            if (menu.open && e.target instanceof Node && !menu.contains(e.target)) menu.open = false;
          });
          document.addEventListener('keydown', (e) => {
            if (e.key !== 'Escape' || !menu.open) return;
            menu.open = false;
            menu.querySelector('summary')?.focus();
          });
          menu.addEventListener('click', (e) => {
            if (e.target instanceof Element && e.target.closest('.tools-panel a')) menu.open = false;
          });
        }
      })();
    </script>

    {
      gaId && (
        <div class="consent" hidden data-consent role="dialog" aria-live="polite" aria-label="Analytics choice">
          <p>
            Can we count how the tools get used? It helps decide what to build next. Your class
            list is never part of it. <a href="/privacy/#analytics">What this collects</a>.
          </p>
          <div class="consent-actions">
            <button class="btn small primary" type="button" data-consent-accept>Allow</button>
            <button class="btn small" type="button" data-consent-decline>No thanks</button>
          </div>
        </div>
      )
    }
    {
      gaId && (
        <script is:inline define:vars={{ gaId }}>
      // Consent gate for Google Analytics.
      //
      // Nothing about GA exists on the page until the teacher says yes: no
      // script, no cookie, no request to Google. That is a deliberate step
      // beyond Consent Mode, which still loads gtag.js and pings Google with
      // consent denied — on a site whose whole claim is that it does not do
      // things behind your back, "we asked first and then did it anyway" would
      // be the wrong shape.
      (() => {
        const KEY = 'rosterowl:consent:v1';
        const bar = document.querySelector('[data-consent]');
        let choice = null;
        try { choice = localStorage.getItem(KEY); } catch {}

        function load() {
          if (window.__roGaLoaded) return;
          window.__roGaLoaded = true;
          const s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
          document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          function gtag() { window.dataLayer.push(arguments); }
          window.gtag = gtag;
          gtag('js', new Date());
          // IP anonymisation is on by default in GA4; ads signals are not, and
          // this site has no advertising to feed.
          gtag('config', gaId, { allow_google_signals: false, allow_ad_personalization_signals: false });
        }

        function decide(value) {
          try { localStorage.setItem(KEY, value); } catch {}
          if (bar) bar.hidden = true;
          if (value === 'granted') load();
        }

        if (choice === 'granted') load();
        else if (choice !== 'denied' && bar) bar.hidden = false;

        bar?.querySelector('[data-consent-accept]')?.addEventListener('click', () => decide('granted'));
        bar?.querySelector('[data-consent-decline]')?.addEventListener('click', () => decide('denied'));

        // Let /privacy offer a way back to this choice without a second UI.
        window.rosterowlResetAnalyticsChoice = () => {
          try { localStorage.removeItem(KEY); } catch {}
          location.reload();
        };
      })();
        </script>
      )
    }

    <script is:inline>
      // Service worker: makes the whole suite work with no connection, which is
      // the state of a great many school networks and every school corridor.
      // Registered by hand rather than by an island so the static pages stay
      // free of Svelte.
      //
      // The worker is built with registerType: 'prompt', so a new version waits
      // instead of taking over — swapping the page out from under a teacher who
      // is halfway through a seating chart would be the wrong trade.
      (() => {
        if (!('serviceWorker' in navigator)) return;

        const banner = document.querySelector('[data-sw-update]');
        let waiting = null;

        function offerUpdate(worker) {
          waiting = worker;
          banner?.removeAttribute('hidden');
        }

        banner?.querySelector('[data-sw-dismiss]')?.addEventListener('click', () => {
          banner.setAttribute('hidden', '');
        });
        banner?.querySelector('[data-sw-reload]')?.addEventListener('click', () => {
          banner.setAttribute('hidden', '');
          waiting?.postMessage({ type: 'SKIP_WAITING' });
        });

        window.addEventListener('load', async () => {
          try {
            const reg = await navigator.serviceWorker.register('/sw.js', { scope: '/' });

            // A worker already waiting from a previous visit. The controller
            // check keeps the very first install quiet — there is nothing to
            // update to yet, and "a new version is ready" would be a lie.
            if (reg.waiting && navigator.serviceWorker.controller) offerUpdate(reg.waiting);

            reg.addEventListener('updatefound', () => {
              const installing = reg.installing;
              installing?.addEventListener('statechange', () => {
                if (installing.state === 'installed' && navigator.serviceWorker.controller) {
                  offerUpdate(installing);
                }
              });
            });
          } catch {
            // No offline support this visit; everything else still works.
          }
        });

        let reloading = false;
        navigator.serviceWorker.addEventListener('controllerchange', () => {
          if (reloading) return;
          reloading = true;
          location.reload();
        });
      })();
    </script>
  </body>
</html>

<style>
  /* The analytics consent bar. Bottom-left so it never covers the canvas view
     controls (bottom-right) or a toast (bottom-centre), and deliberately not a
     modal: a teacher who ignores it can still use every tool on the site. */
  .consent {
    position: fixed;
    left: var(--space-4);
    bottom: calc(var(--space-4) + env(safe-area-inset-bottom));
    z-index: 90;
    width: min(26rem, calc(100vw - 2 * var(--space-4)));
    padding: var(--space-4);
    border: var(--rule-strong);
    border-radius: var(--radius-m);
    background: var(--surface);
    box-shadow: var(--shadow-2);
  }

  .consent[hidden] {
    display: none;
  }

  .consent p {
    margin: 0 0 var(--space-3);
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .consent-actions {
    display: flex;
    gap: var(--space-2);
  }

  .site-shell {
    position: sticky;
    top: 0;
    z-index: 80;
    padding-top: env(safe-area-inset-top);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 82%, transparent);
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(14px);
  }

  .site-shell__inner {
