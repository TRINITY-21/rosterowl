---
import '../styles/global.css';
import OwlMark from '../components/OwlMark.svelte';

interface Props {
  title: string;
  description: string;
  /** Error pages: no canonical (the URL is not a real route) and no indexing. */
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const pathname = Astro.url.pathname;
const tools = [
  { href: '/seating-chart/', label: 'Seating' },
  { href: '/group-maker/', label: 'Groups' },
  { href: '/picker/', label: 'Picker' },
  { href: '/certificates/', label: 'Certificates' },
  { href: '/checklist/', label: 'Checklist' },
  { href: '/name-tags/', label: 'Name tags' },
  { href: '/jobs-chart/', label: 'Jobs' },
  { href: '/bingo/', label: 'Bingo' },
  { href: '/flashcards/', label: 'Flashcards' },
  { href: '/attendance/', label: 'Attendance' },
];
const isHome = pathname === '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#faf7f0" />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    )}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://rosterowl.com/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link
      rel="preload"
      href="/fonts/AtkinsonHyperlegible-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Baloo2-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      // Apply saved theme before paint to avoid a flash. Light paper is the
      // default; dark chalkboard only when the teacher explicitly chose it.
      try {
        let theme = null;
        const raw = localStorage.getItem('rosterowl:v1');
        if (raw) theme = JSON.parse(raw)?.settings?.theme ?? null;
        if (theme !== 'dark' && theme !== 'light') {
          theme = localStorage.getItem('rosterowl:theme');
        }
        if (theme === 'dark') {
          document.documentElement.dataset.theme = 'dark';
          document.querySelector('meta[name="theme-color"]')?.setAttribute('content', '#141d1a');
        }
      } catch {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-shell">
      <div class="site-shell__inner">
        <a
          class="site-brand"
          href="/"
          aria-label="RosterOwl home"
          aria-current={isHome ? 'page' : undefined}
        >
          <OwlMark size={30} />
          <span>RosterOwl</span>
        </a>
        <nav class="site-nav" aria-label="Classroom tools">
          {tools.map((tool) => (
            <a href={tool.href} aria-current={pathname.startsWith(tool.href) ? 'page' : undefined}>
              {tool.label}
            </a>
          ))}
        </nav>
        <div class="site-actions">
          <button
            class="theme-toggle"
            type="button"
            aria-label="Switch to dark chalkboard theme"
            title="Switch theme"
          >
            <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20.5 14.5A8.5 8.5 0 1 1 9.5 3.5a7 7 0 0 0 11 11z" />
            </svg>
            <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8zM12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
          </button>
          <details class="site-menu">
            <summary>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <path d="M4 7h16M4 12h16M4 17h16" />
              </svg>
              Menu
            </summary>
            <nav aria-label="Mobile classroom tools">
              {tools.map((tool) => (
                <a href={tool.href} aria-current={pathname.startsWith(tool.href) ? 'page' : undefined}>
                  {tool.label}
                </a>
              ))}
            </nav>
          </details>
        </div>
      </div>
    </header>
    <div id="main-content" tabindex="-1">
      <slot />
    </div>
    <script is:inline>
      (() => {
        const button = document.querySelector('.theme-toggle');
        if (!(button instanceof HTMLButtonElement)) return;
        const updateLabel = () => {
          const dark = document.documentElement.dataset.theme === 'dark';
          button.setAttribute(
            'aria-label',
            dark ? 'Switch to light paper theme' : 'Switch to dark chalkboard theme'
          );
          // Browser chrome follows the applied theme, not the OS preference.
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute('content', dark ? '#141d1a' : '#faf7f0');
        };
        updateLabel();
        button.addEventListener('click', () => {
          const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          if (next === 'dark') document.documentElement.dataset.theme = 'dark';
          else delete document.documentElement.dataset.theme;
          try {
            // Standalone key so the choice survives even before any class exists.
            localStorage.setItem('rosterowl:theme', next);
            const raw = localStorage.getItem('rosterowl:v1');
            const state = raw ? JSON.parse(raw) : null;
            if (state?.settings) {
              state.settings.theme = next;
              localStorage.setItem('rosterowl:v1', JSON.stringify(state));
            }
          } catch {}
          window.dispatchEvent(new CustomEvent('rosterowl-theme-change', { detail: next }));
          updateLabel();
        });
        // Keep the icon/label right if a Svelte island changes the theme.
        new MutationObserver(updateLabel).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['data-theme'],
        });

        // The mobile menu closes when tapping anywhere else or pressing Escape.
        const menu = document.querySelector('.site-menu');
        if (menu instanceof HTMLDetailsElement) {
          document.addEventListener('pointerdown', (e) => {
            if (menu.open && e.target instanceof Node && !menu.contains(e.target)) menu.open = false;
          });
          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && menu.open) menu.open = false;
          });
        }
      })();
    </script>
  </body>
</html>

<style>
  .site-shell {
    position: sticky;
    top: 0;
    z-index: 80;
    padding-top: env(safe-area-inset-top);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 82%, transparent);
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(14px);
  }

  .site-shell__inner {
    width: min(100%, var(--content-wide));
    min-height: 4rem;
    margin: 0 auto;
    padding: 0 var(--page-gutter);
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .site-brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    margin-left: auto;
  }

  .site-nav a,
  .site-menu a {
    white-space: nowrap;
    border-radius: var(--radius-pill);
    color: var(--muted);
    font-size: var(--text-sm);
    font-weight: 700;
    padding: 0.5rem 0.7rem;
    text-decoration: none;
    transition: background var(--motion-fast) ease, color var(--motion-fast) ease;
  }

  .site-nav a:hover,
  .site-nav a[aria-current='page'],
  .site-menu a:hover,
  .site-menu a[aria-current='page'] {
    background: var(--brand-soft);
    color: var(--brand-strong);
  }

  .site-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .theme-toggle,
  .site-menu summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-width: var(--touch-target);
    min-height: var(--touch-target);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--surface);
    color: var(--ink);
    font-weight: 700;
    transition: background var(--motion-fast) ease, border-color var(--motion-fast) ease;
  }

  .theme-toggle:hover,
  .site-menu summary:hover {
    background: var(--surface-2);
    border-color: var(--line-strong);
  }

  .theme-toggle svg {
    grid-area: 1 / 1;
  }

  .theme-toggle .icon-sun {
    display: none;
  }

  :global(html[data-theme='dark']) .theme-toggle .icon-sun {
    display: block;
  }

  :global(html[data-theme='dark']) .theme-toggle .icon-moon {
    display: none;
  }

  .site-menu {
    display: none;
    position: relative;
  }

  .site-menu summary {
    list-style: none;
    padding: 0 0.8rem;
    cursor: pointer;
    font-size: var(--text-sm);
  }

  .site-menu summary::-webkit-details-marker {
    display: none;
  }

  .site-menu[open] summary {
    background: var(--brand-soft);
    border-color: color-mix(in srgb, var(--brand) 40%, var(--line));
    color: var(--brand-strong);
  }

  .site-menu nav {
    position: absolute;
    top: calc(100% + var(--space-2));
    right: 0;
    width: min(18rem, calc(100vw - 2rem));
    padding: var(--space-2);
    display: grid;
    gap: 1px;
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--surface);
    box-shadow: var(--shadow-2);
  }

  .site-menu a {
    border-radius: var(--radius-s);
  }

  #main-content:focus {
    outline: none;
  }

  @media (max-width: 1200px) {
    .site-nav {
      display: none;
    }

    .site-actions {
      margin-left: auto;
    }

    .site-menu {
      display: block;
    }
  }

  @media (max-width: 420px) {
    .site-shell__inner {
      min-height: 3.75rem;
    }

    .site-brand {
      font-size: 1.1rem;
    }
  }
</style>
