---
import '../styles/global.css';
import Icon from '../components/Icon.svelte';
import OwlMark from '../components/OwlMark.svelte';
import { SEATING, TOOL_GROUPS, activeToolHref } from '../lib/tools';

interface Props {
  title: string;
  description: string;
  /** Error pages: no canonical (the URL is not a real route) and no indexing. */
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const pathname = Astro.url.pathname;
const isHome = pathname === '/';
const activeTool = activeToolHref(pathname);
// The flagship leads the panel on its own; the rest fill the two columns below.
const [planGroup, ...otherGroups] = TOOL_GROUPS;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#faf7f0" />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    )}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://rosterowl.com/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link
      rel="preload"
      href="/fonts/AtkinsonHyperlegible-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Baloo2-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      // Apply saved theme before paint to avoid a flash. Light paper is the
      // default; dark chalkboard only when the teacher explicitly chose it.
      try {
        let theme = null;
        const raw = localStorage.getItem('rosterowl:v1');
        if (raw) theme = JSON.parse(raw)?.settings?.theme ?? null;
        if (theme !== 'dark' && theme !== 'light') {
          theme = localStorage.getItem('rosterowl:theme');
        }
        if (theme === 'dark') {
          document.documentElement.dataset.theme = 'dark';
          document.querySelector('meta[name="theme-color"]')?.setAttribute('content', '#141d1a');
        }
      } catch {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-shell">
      <div class="site-shell__inner">
        <a
          class="site-brand"
          href="/"
          aria-label="RosterOwl home"
          aria-current={isHome ? 'page' : undefined}
        >
          <OwlMark size={32} />
          <span>RosterOwl</span>
        </a>

        <nav class="site-nav" aria-label="Classroom tools">
          <details class="tools-menu" data-tools-menu>
            <summary aria-current={activeTool ? 'page' : undefined}>
              Tools
              <svg
                class="caret"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.6"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg
              >
            </summary>

            <div class="tools-panel">
              <div class="panel-lead">
                <p class="group-label">{planGroup.label}</p>
                <a class="flagship" href={SEATING.href} aria-current={activeTool === SEATING.href ? 'page' : undefined}>
                  <span class="t-icon"><Icon name={SEATING.icon} size={20} /></span>
                  <span class="t-text">
                    <span class="t-name">{SEATING.title}</span>
                    <span class="t-blurb">{SEATING.blurb}</span>
                  </span>
                  <Icon name="arrow-right" size={16} />
                </a>
              </div>

              <div class="panel-cols">
                {otherGroups.map((group) => (
                  <div class:list={['panel-group', `is-${group.key}`]}>
                    <p class="group-label">{group.label}</p>
                    <ul>
                      {group.tools.map((tool) => (
                        <li>
                          <a href={tool.href} aria-current={activeTool === tool.href ? 'page' : undefined}>
                            <span class="t-icon"><Icon name={tool.icon} size={17} /></span>
                            <span class="t-text">
                              <span class="t-name">{tool.label}</span>
                              <span class="t-blurb">{tool.blurb}</span>
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>

              <p class="panel-foot">
                Every tool reads the same class list — paste it once. Nothing is ever uploaded.
              </p>
            </div>
          </details>

          <a
            class="nav-link"
            href="/seating-chart/templates/"
            aria-current={pathname.startsWith('/seating-chart/templates/') ? 'page' : undefined}
          >
            Templates
          </a>
          <a
            class="nav-link"
            href="/privacy/"
            aria-current={pathname.startsWith('/privacy') ? 'page' : undefined}
          >
            Privacy
          </a>
        </nav>

        <div class="site-actions">
          <a class="class-chip" href={SEATING.href} hidden data-class-chip>
            <span class="chip-dot" aria-hidden="true"></span>
            <span class="chip-text" data-class-name></span>
            <span class="chip-count" data-class-count></span>
          </a>
          <button
            class="theme-toggle"
            type="button"
            aria-label="Switch to dark chalkboard theme"
            title="Switch to dark chalkboard theme"
          >
            <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20.5 14.5A8.5 8.5 0 1 1 9.5 3.5a7 7 0 0 0 11 11z" />
            </svg>
            <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8zM12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
          </button>
        </div>
      </div>
    </header>
    <script is:inline>
      // Runs immediately after the header markup, so the chip is filled in the
      // same parse pass — it appears with the header rather than shifting it
      // later. Reads localStorage directly: importing appState here would pull
      // the whole tool bundle onto pages that ship no JavaScript at all.
      (() => {
        const chip = document.querySelector('[data-class-chip]');
        if (!chip) return;
        const render = (cls) => {
          if (!cls || !cls.name || !String(cls.name).trim()) {
            chip.hidden = true;
            return;
          }
          const name = String(cls.name).trim();
          const count = Number(cls.count) || 0;
          chip.querySelector('[data-class-name]').textContent = name;
          chip.querySelector('[data-class-count]').textContent = String(count);
          chip.setAttribute(
            'aria-label',
            `Current class: ${name}, ${count} student${count === 1 ? '' : 's'}. Open the seating chart.`
          );
          chip.hidden = false;
        };
        try {
          const state = JSON.parse(localStorage.getItem('rosterowl:v1') || 'null');
          const classes = state && state.classes;
          if (Array.isArray(classes) && classes.length) {
            const cls = classes.find((c) => c && c.id === state.activeClassId) ?? classes[0];
            // The seeded demo class is not the teacher's own — don't advertise it.
            if (cls && cls.id !== 'sample-class') {
              render({ name: cls.name, count: Array.isArray(cls.students) ? cls.students.length : 0 });
            }
          }
        } catch {}
        // Switching or renaming a class in a tool re-renders the chip in place.
        window.addEventListener('rosterowl-class-change', (e) => render(e.detail));
      })();
    </script>
    <div id="main-content" tabindex="-1">
      <slot />
    </div>
    <script is:inline>
      (() => {
        const button = document.querySelector('.theme-toggle');
        if (!(button instanceof HTMLButtonElement)) return;
        const updateLabel = () => {
          const dark = document.documentElement.dataset.theme === 'dark';
          const label = dark ? 'Switch to light paper theme' : 'Switch to dark chalkboard theme';
          // Tooltip and accessible name must agree — they used to diverge once
          // the theme was toggled.
          button.setAttribute('aria-label', label);
          button.setAttribute('title', label);
          // Browser chrome follows the applied theme, not the OS preference.
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute('content', dark ? '#141d1a' : '#faf7f0');
        };
        updateLabel();
        button.addEventListener('click', () => {
          const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          if (next === 'dark') document.documentElement.dataset.theme = 'dark';
          else delete document.documentElement.dataset.theme;
          try {
            // Standalone key so the choice survives even before any class exists.
            localStorage.setItem('rosterowl:theme', next);
            const raw = localStorage.getItem('rosterowl:v1');
            const state = raw ? JSON.parse(raw) : null;
            if (state?.settings) {
              state.settings.theme = next;
              localStorage.setItem('rosterowl:v1', JSON.stringify(state));
            }
          } catch {}
          window.dispatchEvent(new CustomEvent('rosterowl-theme-change', { detail: next }));
          updateLabel();
        });
        // Keep the icon/label right if a Svelte island changes the theme.
        new MutationObserver(updateLabel).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['data-theme'],
        });

        // The tools panel closes on outside click, on Escape, and once a link
        // inside it is followed (which matters for same-page anchors).
        const menu = document.querySelector('[data-tools-menu]');
        if (menu instanceof HTMLDetailsElement) {
          document.addEventListener('pointerdown', (e) => {
            if (menu.open && e.target instanceof Node && !menu.contains(e.target)) menu.open = false;
          });
          document.addEventListener('keydown', (e) => {
            if (e.key !== 'Escape' || !menu.open) return;
            menu.open = false;
            menu.querySelector('summary')?.focus();
          });
          menu.addEventListener('click', (e) => {
            if (e.target instanceof Element && e.target.closest('.tools-panel a')) menu.open = false;
          });
        }
      })();
    </script>
  </body>
</html>

<style>
  .site-shell {
    position: sticky;
    top: 0;
    z-index: 80;
    padding-top: env(safe-area-inset-top);
    border-bottom: 1px solid color-mix(in srgb, var(--line) 82%, transparent);
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(14px);
  }

  .site-shell__inner {
    width: min(100%, var(--content-wide));
    height: 4rem;
    margin: 0 auto;
    padding: 0 var(--page-gutter);
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .site-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-brand :global(svg) {
    flex: none;
  }

  /* --- nav ---------------------------------------------------------------- */
  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin-right: auto;
  }

  .nav-link,
  .tools-menu summary {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    height: 2.25rem;
    padding: 0 0.7rem;
    border-radius: var(--radius-s);
    color: var(--muted);
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition: color var(--motion-fast) ease, background var(--motion-fast) ease;
  }

  .nav-link:hover,
  .tools-menu summary:hover,
  .tools-menu[open] summary {
    color: var(--ink);
    background: var(--surface-2);
  }

  /* Marigold underline marks the section — the header's one accent, so it never
     reads as another green button. */
  .nav-link[aria-current='page']::after,
  .tools-menu summary[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: 0.1rem;
    height: 2px;
    border-radius: var(--radius-pill);
    background: var(--accent);
  }

  .nav-link[aria-current='page'],
  .tools-menu summary[aria-current='page'] {
    color: var(--ink);
  }

  .tools-menu {
    position: relative;
  }

  .tools-menu summary {
    list-style: none;
  }

  .tools-menu summary::-webkit-details-marker {
    display: none;
  }

  .caret {
    transition: transform var(--motion-fast) var(--ease-standard);
  }

  .tools-menu[open] .caret {
    transform: rotate(180deg);
  }

  /* --- the panel ---------------------------------------------------------- */
  .tools-panel {
    position: absolute;
    top: calc(100% + 0.55rem);
    left: 0;
    z-index: 10;
    width: min(46rem, calc(100vw - 2 * var(--page-gutter)));
    padding: var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--surface);
    box-shadow: var(--shadow-2);
    animation: panel-in var(--motion-fast) var(--ease-standard);
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  .group-label {
    margin: 0 0 var(--space-2);
    padding-left: 0.55rem;
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .panel-cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
    gap: var(--space-4);
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: var(--rule);
  }

  .panel-group ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Six items read better as two short columns than one long one. */
  .panel-group.is-print ul {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 var(--space-2);
  }

  .tools-panel a {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.5rem 0.55rem;
    border-radius: var(--radius-s);
    color: var(--ink);
    text-decoration: none;
    transition: background var(--motion-fast) ease;
  }

  .tools-panel a:hover {
    background: var(--surface-2);
  }

  .tools-panel a[aria-current='page'] {
    background: var(--brand-soft);
  }

  .t-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.35rem;
    height: 1.35rem;
    margin-top: 0.1rem;
    color: var(--brand);
  }

  .tools-panel a[aria-current='page'] .t-icon {
    color: var(--brand-strong);
  }

  .t-text {
    display: grid;
    gap: 0.05rem;
    min-width: 0;
  }

  .t-name {
    font-weight: 700;
    font-size: var(--text-sm);
    line-height: 1.3;
  }

  .t-blurb {
    color: var(--muted);
    font-size: var(--text-xs);
    line-height: 1.35;
  }

  /* The flagship: one step louder than the nine below it. */
  .flagship {
    border: var(--rule);
    background: var(--surface-2);
  }

  .flagship:hover {
    border-color: color-mix(in srgb, var(--brand) 40%, var(--line));
    background: var(--brand-soft);
  }

  .flagship .t-icon {
    width: 2.1rem;
    height: 2.1rem;
    margin-top: 0;
    border-radius: var(--radius-s);
    background: var(--brand);
    color: var(--on-brand);
  }

  .flagship .t-name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }

  .flagship .t-blurb {
    font-size: var(--text-sm);
  }

  .flagship :global(svg:last-child) {
    flex: none;
    margin-left: auto;
    align-self: center;
    color: var(--muted);
  }

  .panel-foot {
    margin: var(--space-3) 0 0;
    padding: var(--space-3) 0.55rem 0;
    border-top: var(--rule);
    color: var(--muted);
    font-size: var(--text-xs);
  }

  /* --- actions ------------------------------------------------------------ */
  .site-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* The class selector outranks the UA's [hidden] rule, so restore it here —
     without this the empty chip shows on every page with no saved class. */
  .class-chip[hidden] {
    display: none;
  }

  .class-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    max-width: 14rem;
    height: 2.25rem;
    padding: 0 0.7rem;
    border: var(--rule);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--ink);
    font-size: var(--text-xs);
    font-weight: 700;
    text-decoration: none;
    transition: border-color var(--motion-fast) ease, background var(--motion-fast) ease;
  }

  .class-chip:hover {
    border-color: color-mix(in srgb, var(--brand) 45%, var(--line));
    background: var(--brand-soft);
  }

  .chip-dot {
    flex: none;
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--ok);
  }

  .chip-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .chip-count {
    flex: none;
    padding-left: 0.4rem;
    border-left: var(--rule);
    color: var(--muted);
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--touch-target);
    height: var(--touch-target);
    border: var(--rule);
    border-radius: var(--radius-m);
    background: var(--surface);
    color: var(--ink);
    transition: background var(--motion-fast) ease, border-color var(--motion-fast) ease;
  }

  .theme-toggle:hover {
    background: var(--surface-2);
    border-color: var(--line-strong);
  }

  .theme-toggle .icon-sun {
    display: none;
  }

  :global(html[data-theme='dark']) .theme-toggle .icon-sun {
    display: block;
  }

  :global(html[data-theme='dark']) .theme-toggle .icon-moon {
    display: none;
  }

  #main-content:focus {
    outline: none;
  }

  /* --- responsive --------------------------------------------------------- */
  @media (max-width: 900px) {
    .nav-link {
      display: none;
    }
  }

  /* A closed <details> is laid out under containment rather than removed, and a
     position:fixed panel inside it still contributed to the document's scroll
     width — a phantom 44px of horizontal scroll on every tool page. */
  .tools-menu:not([open]) .tools-panel {
    display: none;
  }

  @media (max-width: 760px) {
    /* The panel becomes a sheet anchored under the header, not a popover. */
    .tools-panel {
      position: fixed;
      top: calc(4rem + env(safe-area-inset-top));
      left: 0;
      right: 0;
      width: auto;
      max-height: calc(100dvh - 4rem - env(safe-area-inset-top));
      overflow-y: auto;
      padding: var(--space-4) var(--page-gutter) calc(var(--space-5) + env(safe-area-inset-bottom));
      border-inline: none;
      border-radius: 0 0 var(--radius-l) var(--radius-l);
      overscroll-behavior: contain;
    }

    .panel-cols {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
    }

    .panel-group.is-print ul {
      grid-template-columns: minmax(0, 1fr);
    }

    .tools-panel a {
      min-height: var(--touch-target);
      align-items: center;
    }
  }

  @media (max-width: 620px) {
    .class-chip {
      display: none;
    }

    .site-shell__inner {
      gap: var(--space-3);
    }
  }

  @media (max-width: 380px) {
    .site-brand span {
      font-size: 1.15rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tools-panel {
      animation: none;
    }
  }
</style>
